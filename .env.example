# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# Database Configuration
# Use DATABASE_URL for a single connection string (takes priority over individual vars)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/db_name?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=jari
DB_SSLMODE=disable

# JWT Configuration
# Required unless ENV=development (then an insecure dev-only secret is used).
# Placeholder values like "your-secret-key" are rejected. Generate one: openssl rand -hex 32
JWT_SECRET=

# CORS Configuration
# Comma-separated origins allowed to call the API from a browser.
# Use "*" to allow every origin (sent without credentials; fine for Bearer-token auth).
# Empty = reject all cross-origin requests (the embedded SPA is same-origin and unaffected).
# With ENV=development and empty, the Vite dev server (http://localhost:5173) is allowed.
CORS_ALLOWED_ORIGINS=

# Logging
# trace|debug|info|warn|error|fatal|panic. Empty = info for the app log.
# Also drives the GORM SQL logger: debug/trace log every statement, info/warn only
# slow queries and errors, error errors only. Empty: development logs every
# statement, other environments only slow queries and errors.
# ENV=production writes logs as JSON (one object per line, with request_id).
LOG_LEVEL=

# Environment: development | production | test (docker-compose forces production)
ENV=development
